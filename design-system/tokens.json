{
  "$description": "Pretzel Labs design tokens (W3C Design Tokens format). Mirror of the :root block in css/pretzel.css — if you change one, change both.",
  "color": {
    "ink":        { "$type": "color", "$value": "#1d1d1d", "$description": "Headings and body text" },
    "muted":      { "$type": "color", "$value": "#4d585f", "$description": "Secondary text, nav links, captions" },
    "accent":     { "$type": "color", "$value": "#f64c26", "$description": "The orange. Links, progress, italic phrase in the hero title, primary button" },
    "accent-hi":  { "$type": "color", "$value": "#ff6a45", "$description": "Only the light end of the primary button gradient" },
    "surface":    { "$type": "color", "$value": "#edf1f4", "$description": "Grey cards, hover fills" },
    "surface-hi": { "$type": "color", "$value": "#e3e9ef", "$description": "Burger hover" },
    "sky":        { "$type": "color", "$value": "#cfe3f7", "$description": "Flat sky under a photo card while it loads" },
    "paper":      { "$type": "color", "$value": "#ffffff" },
    "ok":         { "$type": "color", "$value": "#10b981", "$description": "On track / commit" },
    "warn":       { "$type": "color", "$value": "#ff8b06", "$description": "Needs attention" },
    "risk":       { "$type": "color", "$value": "#f51c23", "$description": "At risk (derived chips only)" },
    "track":      { "$type": "color", "$value": "rgba(29, 29, 29, 0.08)", "$description": "Empty part of a progress bar" }
  },
  "shadow": {
    "ring":        { "$type": "shadow", "$value": "0 0 0 4px rgba(221, 229, 237, 0.7)", "$description": "Signature 4px ring on every card-like container" },
    "ring-hover":  { "$type": "shadow", "$value": "0 0 0 4px rgba(246, 76, 38, 0.55)" },
    "glass":       { "$type": "shadow", "$value": "0 8px 30px rgba(29, 29, 29, 0.08)" },
    "glass-lift":  { "$type": "shadow", "$value": "0 16px 40px rgba(29, 29, 29, 0.14)" },
    "btn-bevel":   { "$type": "shadow", "$value": "inset 4px 4px 8px rgba(255,255,255,.3), inset -4px -4px 8px rgba(255,255,255,.3)" },
    "btn-primary": { "$type": "shadow", "$value": "0 8px 16px rgba(246, 76, 38, 0.45)" },
    "btn-dark":    { "$type": "shadow", "$value": "0 8px 16px rgba(29, 29, 29, 0.5)" },
    "btn-dark-sm": { "$type": "shadow", "$value": "0 4px 16px rgba(29, 29, 29, 0.5)" }
  },
  "gradient": {
    "primary": { "$type": "gradient", "$value": "linear-gradient(110deg, #ff6a45 0%, #f64c26 100%)" },
    "dark":    { "$type": "gradient", "$value": "linear-gradient(110deg, #323232 0%, #000 100%)" },
    "hero-fade": { "$type": "gradient", "$value": "linear-gradient(rgba(255,255,255,0) 0%, rgba(255,255,255,.7) 50%, #fff 100%)" }
  },
  "glass": {
    "background": { "$type": "color", "$value": "rgba(255, 255, 255, 0.55)" },
    "border":     { "$type": "color", "$value": "rgba(255, 255, 255, 0.7)" },
    "blur":       { "$type": "dimension", "$value": "14px" }
  },
  "radius": {
    "pill": { "$type": "dimension", "$value": "100px", "$description": "Buttons, pills, bars, nav links" },
    "nav":  { "$type": "dimension", "$value": "56px",  "$description": "Nav capsule" },
    "xl":   { "$type": "dimension", "$value": "30px",  "$description": "Reason tiles, stepper, split media card, CTA card" },
    "lg":   { "$type": "dimension", "$value": "24px",  "$description": "Glass panels, mobile menu" },
    "md":   { "$type": "dimension", "$value": "20px",  "$description": "Bento tiles, compare rows" },
    "sm":   { "$type": "dimension", "$value": "14px",  "$description": "Inset cells" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Space Grotesk", "sans-serif"], "$description": "All titles, big numbers. Weight 600." },
    "text":    { "$type": "fontFamily", "$value": ["DM Sans", "sans-serif"], "$description": "Everything else. Base weight 500; 600 for labels, buttons, values." }
  },
  "type": {
    "h-xl":    { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "clamp(52px, 7vw, 100px)", "lineHeight": 1,    "letterSpacing": "-1.4px" }, "$description": "≤1024: clamp(40px, 11vw, 72px)" },
    "h-lg":    { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "clamp(40px, 5vw, 64px)",  "lineHeight": 1.05, "letterSpacing": "-1.5px" }, "$description": "≤1024: clamp(34px, 9vw, 56px); inside .pl-cta clamp(30px, 8vw, 44px)" },
    "h-md":    { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "clamp(34px, 4vw, 48px)",  "lineHeight": 1.2,  "letterSpacing": "-1px" },   "$description": "≤1024: clamp(30px, 8vw, 44px)" },
    "h-sm":    { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "28px", "lineHeight": 1.2, "letterSpacing": "-0.5px" } },
    "h-xs":    { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "20px", "lineHeight": 1.2 } },
    "stat":    { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "56px", "lineHeight": 1, "letterSpacing": "-2px" } },
    "step-num":{ "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "64px", "lineHeight": 1, "letterSpacing": "-2px" } },
    "lead":    { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontWeight": 500, "fontSize": "20px", "lineHeight": "26px" } },
    "lead-sm": { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontWeight": 500, "fontSize": "18px", "lineHeight": 1.3 } },
    "body":    { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontWeight": 500, "fontSize": "16px", "lineHeight": 1.3 } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontWeight": 500, "fontSize": "14px", "lineHeight": 1.4 } },
    "label":   { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontWeight": 500, "fontSize": "13px", "lineHeight": 1.3 } },
    "button":  { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontWeight": 600, "fontSize": "18px" }, "$description": "Nav button: 14px (13px at ≤640)" }
  },
  "space": {
    "$description": "The spacing ladder. Use these values only.",
    "scale": { "$type": "dimension", "$value": ["6px", "10px", "14px", "20px", "30px", "40px", "70px", "100px"] },
    "gutter":         { "$type": "dimension", "$value": "30px" },
    "container":      { "$type": "dimension", "$value": "1200px" },
    "section-top":    { "$type": "dimension", "$value": "130px", "$description": "90px at ≤1024" },
    "section-head-to-body": { "$type": "dimension", "$value": "70px" },
    "cta-to-footer":  { "$type": "dimension", "$value": "100px" },
    "page-bottom":    { "$type": "dimension", "$value": "100px" }
  },
  "breakpoint": {
    "tablet": { "$type": "dimension", "$value": "1024px", "$description": "max-width. Nav → burger, grids → one column, section top 130 → 90" },
    "phone":  { "$type": "dimension", "$value": "640px",  "$description": "max-width. Wordmark hidden, button pairs full width, mobile hero image" }
  },
  "motion": {
    "ease":        { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1], "$description": "The only easing curve" },
    "fast":        { "$type": "duration", "$value": "200ms", "$description": "Colour/background/filter changes" },
    "ring":        { "$type": "duration", "$value": "300ms", "$description": "Ring colour on hover" },
    "glass-lift":  { "$type": "duration", "$value": "500ms" },
    "progress":    { "$type": "duration", "$value": "500ms" },
    "photo-zoom":  { "$type": "duration", "$value": "800ms" },
    "edge-light":  { "$type": "duration", "$value": "9s", "$description": "One lap of the light along a live glass panel" },
    "step-autoplay": { "$type": "duration", "$value": "4000ms" }
  }
}
